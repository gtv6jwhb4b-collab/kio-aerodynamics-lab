<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>KIO AeroLab | Engineering Analysis Suite</title>

<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
body{
    margin:0;
    background:#2b2b2b;
    font-family:Arial;
    color:white;
    overflow:hidden;
}

#panel{
    position:absolute;
    left:20px;
    top:20px;
    width:480px;
    background:#3a3a3a;
    padding:20px;
    border-radius:10px;
}

h1{
    font-size:18px;
}

label{
    font-size:12px;
    margin-top:8px;
    display:block;
}

input, select, button{
    width:100%;
    padding:6px;
    margin-top:4px;
    background:#555;
    border:none;
    color:white;
}

button{
    background:red;
    font-weight:bold;
    cursor:pointer;
}

#telemetry{
    margin-top:10px;
    font-size:12px;
    line-height:1.6;
    background:#444;
    padding:10px;
    border-radius:6px;
}

#graphContainer{
    margin-top:10px;
    background:#444;
    padding:10px;
    border-radius:6px;
}

canvas{
    width:100%;
}
</style>
</head>

<body>

<div id="panel">
<h1>KIO AeroLab</h1>
<div style="font-size:11px;">Engineering Analysis Suite</div>

<label>Wind Speed (m/s)</label>
<input type="number" id="wind" value="20">

<label>Ride Height (mm)</label>
<input type="number" id="ride" value="30">

<label>Drag Coefficient (Cd)</label>
<input type="number" id="cd" value="0.30">

<label>Frontal Area (m²)</label>
<input type="number" id="area" value="1.5">

<label>Wheel Diameter (m)</label>
<input type="number" id="wheel" value="0.6">

<label>Import Model (.glb/.gltf)</label>
<input type="file" id="upload">

<button onclick="runAnalysis()">Run Analysis</button>
<button onclick="generateReport()">Generate Engineering Report (PDF)</button>

<div id="telemetry"></div>

<div id="graphContainer">
<canvas id="dragGraph"></canvas>
</div>
</div>

<script>
// THREE.JS SETUP
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x2b2b2b);

const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 1000);
camera.position.set(0, 2, 7);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// ORBIT CONTROLS
const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;

// LIGHTING
const light = new THREE.DirectionalLight(0xffffff, 1);
light.position.set(5, 10, 5);
scene.add(light);

// MODEL
let currentModel = new THREE.Mesh(
    new THREE.BoxGeometry(2, 0.8, 1.2),
    new THREE.MeshStandardMaterial({ color: 0x888888, vertexColors: true })
);
scene.add(currentModel);

// AIRFLOW
let flowParticles;
function createFlow(){
    if(flowParticles) scene.remove(flowParticles);

    const geo = new THREE.BufferGeometry();
    const count = 3500;
    const positions = new Float32Array(count * 3);

    for(let i=0;i<count;i++){
        positions[i*3] = (Math.random()-0.5) * 6;
        positions[i*3+1] = (Math.random()-0.5) * 3;
        positions[i*3+2] = (Math.random()-0.5) * 3;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(positions,3));

    const mat = new THREE.PointsMaterial({
        size: 0.04,
        color: 0xff0000
    });

    flowParticles = new THREE.Points(geo, mat);
    scene.add(flowParticles);
}

createFlow();

// PRESSURE HEATMAP
function createPressureMap(){
    currentModel.traverse(child=>{
        if(child.isMesh){
            const geometry = child.geometry;
            const pos = geometry.attributes.position;

            const colors = [];

            for(let i=0;i<pos.count;i++){
                const y = pos.getY(i);
                const pressure = 1 - (y * 0.2);

                colors.push(
                    pressure,
                    0,
                    1 - pressure
                );
            }

            geometry.setAttribute('color', new THREE.Float32BufferAttribute(colors,3));
            child.material = new THREE.MeshStandardMaterial({
                vertexColors: true,
                side: THREE.DoubleSide
            });
        }
    });
}

// DRAG & WHEEL SIMULATION
let dragData = [];

function runAnalysis(){
    const v = parseFloat(document.getElementById("wind").value);
    const Cd = parseFloat(document.getElementById("cd").value);
    const A = parseFloat(document.getElementById("area").value);
    const wheel = parseFloat(document.getElementById("wheel").value);

    dragData = [];

    for(let speed = 0; speed <= v; speed += 5){
        const rho = 1.225;
        const drag = 0.5 * rho * speed * speed * Cd * A;

        // wheel/tire drag (rolling resistance)
        const wheelDrag = 0.02 * wheel * speed;

        dragData.push({
            speed,
            drag: drag + wheelDrag
        });
    }

    document.getElementById("telemetry").innerHTML = `
    Drag at ${v} m/s: ${dragData[dragData.length-1].drag.toFixed(2)} N
    `;

    createFlow();
    createPressureMap();
    drawGraph();
}

// GRAPH VISUALIZATION (Drag vs Speed)
let chart;

function drawGraph(){
    const ctx = document.getElementById('dragGraph').getContext('2d');

    const labels = dragData.map(d => d.speed);
    const values = dragData.map(d => d.drag);

    if(chart) chart.destroy();

    chart = new Chart(ctx, {
        type: 'line',
        data: {
            labels,
            datasets: [{
                label: 'Drag Force (N)',
                data: values,
                borderColor: 'red',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            scales: {
                x: { title: { display: true, text: 'Speed (m/s)' } },
                y: { title: { display: true, text: 'Drag (N)' } }
            }
        }
    });
}

// ENGINEERING REPORT (PDF)
function generateReport(){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    doc.text("KIO AeroLab Engineering Report", 10, 10);
    doc.text("Aerodynamic Analysis", 10, 20);

    dragData.forEach((d,i)=>{
        doc.text(`Speed: ${d.speed} m/s - Drag: ${d.drag.toFixed(2)} N`, 10, 30 + (i*10));
    });

    doc.save("KIO_Aero_Report.pdf");
}

// FLOW ANIMATION
function animate(){
    requestAnimationFrame(animate);

    if(flowParticles){
        const pos = flowParticles.geometry.attributes.position.array;

        for(let i=0;i<pos.length;i+=3){
            pos[i] += 0.5;

            if(Math.abs(pos[i]) < 1.4 && Math.abs(pos[i+1]) < 0.7){
                pos[i+1] += 0.05;
            }

            if(pos[i] > 4) pos[i] = -4;
        }

        flowParticles.geometry.attributes.position.needsUpdate = true;
    }

    controls.update();
    renderer.render(scene, camera);
}

animate();

// RESIZE
window.addEventListener("resize",()=>{
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>

</body>
</html>
