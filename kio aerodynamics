<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>KIO AeroLab | Wind Flow Around Object</title>

<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/build/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.152.2/examples/js/controls/OrbitControls.js"></script>

<style>
body{
    margin:0;
    background:#3a3a3a;
    font-family:Arial;
    color:white;
    overflow:hidden;
}

#panel{
    position:absolute;
    left:20px;
    top:20px;
    width:420px;
    background:#4a4a4a;
    padding:20px;
    border-radius:10px;
}

h1{
    font-size:18px;
    margin-bottom:5px;
}

.sub{
    font-size:11px;
    margin-bottom:10px;
}

label{
    font-size:12px;
    margin-top:8px;
    display:block;
}

input{
    width:100%;
    padding:6px;
    margin-top:4px;
    background:#555;
    border:none;
    color:white;
}

button{
    width:100%;
    margin-top:10px;
    padding:8px;
    background:red;
    border:none;
    font-weight:bold;
    cursor:pointer;
}

#telemetry{
    margin-top:12px;
    font-size:12px;
    line-height:1.6;
    background:#555;
    padding:10px;
    border-radius:6px;
}
</style>
</head>

<body>

<div id="panel">
<h1>KIO Wind Tunnel</h1>
<div class="sub">Keep It Original – Engineered by Bam Vytlas</div>

<label>Wind Speed (m/s)</label>
<input type="number" id="wind" value="60">

<label>Drag Coefficient (Cd)</label>
<input type="number" id="cd" value="0.30">

<label>Lift Coefficient (Cl)</label>
<input type="number" id="cl" value="-1.5">

<label>Frontal Area (m²)</label>
<input type="number" id="area" value="1.5">

<label>Import Model (.glb/.gltf)</label>
<input type="file" id="upload">

<button onclick="runSim()">Run Simulation</button>

<div id="telemetry"></div>
</div>

<script>
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x3a3a3a);

const camera = new THREE.PerspectiveCamera(70,window.innerWidth/window.innerHeight,0.1,1000);
camera.position.set(0,2,7);

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setSize(window.innerWidth,window.innerHeight);
document.body.appendChild(renderer.domElement);

// ORBIT CONTROLS (camera movement)
const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.07;
controls.minDistance = 2;
controls.maxDistance = 20;

const light = new THREE.DirectionalLight(0xffffff,1);
light.position.set(5,10,5);
scene.add(light);

// TEST OBJECT (default)
let currentModel = new THREE.Mesh(
    new THREE.BoxGeometry(2,0.8,1.2),
    new THREE.MeshStandardMaterial({color:0x888888})
);
scene.add(currentModel);

// IMPORT MODEL
const loader = new THREE.GLTFLoader();
document.getElementById("upload").addEventListener("change",e=>{
    const file=e.target.files[0];
    const reader=new FileReader();
    reader.onload=function(ev){
        loader.parse(ev.target.result,'',gltf=>{
            scene.remove(currentModel);
            currentModel=gltf.scene;
            scene.add(currentModel);
        });
    };
    reader.readAsArrayBuffer(file);
});

// AIRFLOW PARTICLES (around object only)
let flowParticles;
function createFlow(){
    if(flowParticles) scene.remove(flowParticles);

    const geo = new THREE.BufferGeometry();
    const count = 2000;
    const positions = new Float32Array(count * 3);

    for(let i=0;i<count;i++){
        // Spawn near object area
        positions[i*3]     = (Math.random()-0.5) * 6;
        positions[i*3 + 1]  = (Math.random()-0.5) * 3;
        positions[i*3 + 2]   = (Math.random()-0.5) * 3;
    }

    geo.setAttribute('position', new THREE.BufferAttribute(positions,3));

    const mat = new THREE.PointsMaterial({
        size:0.04,
        color:0xff0000
    });

    flowParticles = new THREE.Points(geo,mat);
    scene.add(flowParticles);
}

createFlow();

// SIMULATION LOGIC
let windSpeed = 60;

function runSim(){
    const v = parseFloat(document.getElementById("wind").value);
    const Cd = parseFloat(document.getElementById("cd").value);
    const Cl = parseFloat(document.getElementById("cl").value);
    const A  = parseFloat(document.getElementById("area").value);

    const rho = 1.225;
    const q = 0.5 * rho * v * v;
    const drag = q * Cd * A;
    const lift = q * Cl * A;

    windSpeed = v;

    document.getElementById("telemetry").innerHTML = `
    Dynamic Pressure: ${q.toFixed(2)} Pa<br>
    Drag Force: ${drag.toFixed(1)} N<br>
    Downforce: ${lift.toFixed(1)} N
    `;

    createFlow();
}

// FLOW ANIMATION (around object)
function animate(){
    requestAnimationFrame(animate);

    if(flowParticles){
        const pos = flowParticles.geometry.attributes.position.array;

        for(let i=0;i<pos.length;i+=3){
            // Move particles toward back (wind direction)
            pos[i] += windSpeed * 0.01;

            // If near object center, deflect upward (simulating flow)
            if(Math.abs(pos[i]) < 1.2 && Math.abs(pos[i+1]) < 0.6){
                pos[i+1] += 0.05;
            }

            if(pos[i] > 4) pos[i] = -4;
        }

        flowParticles.geometry.attributes.position.needsUpdate = true;
    }

    controls.update();
    renderer.render(scene,camera);
}

animate();

window.addEventListener("resize",()=>{
    camera.aspect=window.innerWidth/window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth,window.innerHeight);
});
</script>

</body>
</html>
